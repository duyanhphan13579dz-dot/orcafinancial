{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "drizzle-kit push --force && next build",
    "db:push": "drizzle-kit push",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tcbs:oauth:refresh": "node scripts/refresh-tcbs-oauth.mjs",
    "tcbs:crawl:financials": "node scripts/crawl-tcbs-financials.mjs",
    "tcbs:parse:datapack": "node scripts/parse-tcbs-datapack.mjs",
    "tcbs:worker:quarterly": "node scripts/tcbs-quarterly-worker.mjs",
    "llm:evaluate": "tsx scripts/evaluate-financial-llm.ts",
    "test:financial": "vitest run tests/financial-phase12.test.ts tests/financial-phase34.test.ts",
    "financial:release-gate": "tsx -e \"import { runFinancialReleaseGate } from './src/lib/financial-release-gate'; runFinancialReleaseGate({ skipDb: process.env.SKIP_DB==='1' }).then(r=>{console.log(JSON.stringify(r,null,2)); process.exit(r.ok?0:1)})\""
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@supabase/supabase-js": "^2.111.0",
    "@types/bcryptjs": "^2.4.6",
    "@upstash/redis": "^1.35.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.9",
    "lightweight-charts": "^5.2.1",
    "next": "16.2.6",
    "pdfkit": "^0.20.1",
    "pg": "8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.0",
    "rss-parser": "^3.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}

# ── Database ──────────────────────────────────────────────────────────────
# Option A — Local / self-hosted PostgreSQL (default for this sandbox):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Option B — Supabase (uncomment and fill in to migrate; see
# docs/SUPABASE_MIGRATION.md for the full step-by-step guide).
#
# Direct connection (use for `npx drizzle-kit push` / migrations / pg_dump):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Pooled connection via PgBouncer (recommended for the running app —
# required if deploying to serverless/edge; append pgbouncer=true so
# node-postgres/Drizzle don't attempt server-side prepared statements,
# which PgBouncer's transaction pooling mode does not support):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true

# Connection pool tuning (pg.Pool) — safe defaults, override if needed.
# When DATABASE_URL points at a PgBouncer/pooler host, DATABASE_POOL_MAX
# automatically defaults to 5 instead of 20 (see src/db/index.ts) to avoid
# exhausting the pooler's own connection budget; override here if needed.
DATABASE_POOL_MAX=20
DATABASE_POOL_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# Startup retry: how many times / how far apart to retry connecting to the
# database when the app boots before a compose `postgres` container is ready.
DATABASE_STARTUP_RETRIES=10
DATABASE_STARTUP_RETRY_DELAY_MS=2000

# Background self-ping + escalation thresholds.
DATABASE_SELF_PING_INTERVAL_MS=30000
DATABASE_DOWN_ALERT_AFTER_MS=120000

# ── docker-compose.yml only (self-hosted local Postgres deployments) ───────
POSTGRES_USER=orca
POSTGRES_PASSWORD=orca
POSTGRES_DB=orca_financial

# ── Supabase (optional) — enables Auth / Realtime / Storage from the app ───
# Found in Supabase Dashboard → Project Settings → API.
# NEXT_PUBLIC_* vars are exposed to the browser bundle — only put the two
# below there, never the service role key.
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...              # safe for browser (RLS-protected)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...                  # SERVER-ONLY, bypasses RLS — never expose to client

# ── Connector resilience (see src/lib/connectors/core.ts) ──────────────────
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000
CONNECTOR_RETRY_ATTEMPTS=3
CONNECTOR_RETRY_BASE_MS=1000
CONNECTOR_FETCH_TIMEOUT_MS=10000
CONNECTOR_STALE_AFTER_MS=900000
CONNECTOR_DEGRADED_AFTER_MS=300000
CONNECTOR_ALERT_AFTER_MS=300000

# Optional: Slack webhook for connector DOWN alerts.
# SLACK_WEBHOOK_URL=

# ── LLM (Z.AI GLM primary) — AI Agent + hybrid sentiment ───────────────────
# Cascade default: glm → openrouter (optional free GLM via OpenRouter)
# Override: LLM_PROVIDER_ORDER=glm,openrouter
#
# Z.AI / Zhipu GLM — https://z.ai or https://open.bigmodel.cn
# Free API models: glm-4.7-flash, glm-4.5-flash
# Flagship: glm-5.2, glm-5.3 (credits / paid)
# ZAI_API_KEY=
# (aliases also accepted: ZHIPU_API_KEY, GLM_API_KEY, BIGMODEL_API_KEY)
# GLM_MODEL=glm-4.7-flash
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# (China alternate: https://open.bigmodel.cn/api/paas/v4)
#
# Optional OpenRouter fallback for z-ai/glm-5.2:free — https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=z-ai/glm-5.2:free
# OPENROUTER_SITE_URL=https://your-domain.com
# OPENROUTER_APP_NAME=ORCA Financial
#
# Set to 1 to force rule-engine only for sentiment (no LLM calls)
# LLM_SENTIMENT_DISABLED=0

# ── Commodities real-time scanner ──────────────────────────────────────────
# Authoritative source for commodity prices: "simplize" | "vietnambiz".
# Both sources are scanned every cycle for health monitoring, but each stored
# snapshot comes from exactly ONE source — prices are never averaged/blended.
COMMODITY_PRIMARY_SOURCE=simplize
# How often to run a scan cycle (ms). 60s is a good balance for these sources.
COMMODITY_SCAN_INTERVAL_MS=60000
# Retention for intraday snapshots (daily closes are always kept).
COMMODITY_RETENTION_DAYS=30
COMMODITY_PRUNE_INTERVAL_MS=21600000

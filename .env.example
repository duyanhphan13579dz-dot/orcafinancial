# ── Database ──────────────────────────────────────────────────────────────
# Option A — Local / self-hosted PostgreSQL (default for this sandbox):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Option B — Supabase (uncomment and fill in to migrate; see
# docs/SUPABASE_MIGRATION.md for the full step-by-step guide).
#
# Direct connection (use for `npx drizzle-kit push` / migrations / pg_dump):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.
#
# Background self-ping + escalation thresholds.
DATABASE_SELF_PING_INTERVAL_MS=30000
DATABASE_DOWN_ALERT_AFTER_MS=120000

# ── docker-compose.yml only (self-hosted local Postgres deployments) ───────
POSTGRES_USER=orca
POSTGRES_PASSWORD=orca
POSTGRES_DB=orca_financial

# ── Supabase (optional) — enables Auth / Realtime / Storage from the app ───
# Found in Supabase Dashboard → Project Settings → API.
# NEXT_PUBLIC_* vars are exposed to the browser bundle — only put the two
# below there, never the service role key.

# Optional: Slack webhook for connector DOWN alerts.
# SLACK_WEBHOOK_URL=

# ── Multi-provider LLM (free tier first) — used by AI Agent + hybrid sentiment ─
# Cascade order (default): gemini → groq → openrouter → anthropic
# Override: LLM_PROVIDER_ORDER=gemini,groq,openrouter,anthropic
#
# Google Gemini free tier (~1,500 req/day Flash) — recommended primary
# Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
#
# Groq free tier (very fast LPU) — https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# OpenRouter free models — https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional economic calendar enrichment
FINNHUB_API_KEY=
# ── Quarterly financial-period audit ───────────────────────────────────────
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> automatically.
CRON_SECRET=
# Optional separate secret if the audit endpoint is called by another scheduler.
FINANCIAL_AUDIT_SECRET=
FINANCIAL_AUDIT_SYMBOLS=VNM,HPG,FPT,VCB
FINANCIAL_INGEST_SYMBOLS=VNM,HPG,FPT,VCB
# Licensed/approved JSON endpoint contracts. Do not bypass authentication or rate limits.
VIETSTOCK_DATAFEED_URL=
VIETSTOCK_DATAFEED_TOKEN=
CAFEF_DATA_URL=
CAFEF_DATA_TOKEN=

# ── SSI FastConnect (market data only — no trading) ────────────────────────
# Provider: https://developers.ssi.com.vn/
# Register at a branch / hotline 1900 545 471, then activate from the portal email.
#
# SCOPE: REST market data + WebSocket channel DATA (trade/quote/room/put/oddlot/market).
#        Order placement, FCO, account, position and balance APIs are NOT used.
#        => No OTP, no SmartOTP/iBoard, no RSA private key, no X-Signature header.
#
# Set all four to enable. Leave SSI_API_KEY empty to keep VNDirect as primary.
# Never commit real credentials — set these in Vercel → Project Settings →
# Environment Variables (Production / Preview / Development as appropriate).
#
# Consumer ID issued with the FastConnect contract (a.k.a. clientId, e.g. "666666").
SSI_CLIENT_ID=
# API key + secret pair from the Developer Portal.
SSI_API_KEY=
SSI_API_SECRET=
# Base URL. Leave empty for production (https://api.ssi.com.vn).
SSI_REST_BASE_URL=
# WebSocket stream. Leave empty for production (wss://stream.ssi.com.vn).
SSI_WS_URL=
# Optional overrides — safe to leave unset.
# Access-token cache TTL in ms before proactive refresh (default 60000).
# SSI_TOKEN_CACHE_TTL_MS=
# Refresh the token this many ms before expiry (default 300000).
# SSI_TOKEN_REFRESH_SKEW_MS=
# Per-request timeout for REST market data in ms (default 8000).
# SSI_REST_TIMEOUT_MS=
# Enable the persistent WebSocket DATA worker (default false until a worker host exists).
# NOTE: do not open WebSocket connections inside serverless request handlers.
# SSI_WS_ENABLED=
# ── Worker only (scripts/ssi-stream-worker.ts, `npm run ssi:stream`) ───────
# These are read by the long-lived worker process, never by request handlers.
# Symbols to stream. Default: the 20 featured dashboard symbols.
# SSI_STREAM_SYMBOLS=VNM,VIC,VHM,HPG,FPT,MWG,VCB,TCB,BID,CTG,SSI,VND,MSN,GAS,VRE,MBB,STB,HDB,POW,GVR
# Topics: trade,quote,room,put,oddlot,market (default: trade,quote,room,market)
# SSI_STREAM_TOPICS=trade,quote,room,market
# Flush aggregated bars to Postgres every N ms (default 5000).
# SSI_STREAM_FLUSH_MS=5000
# Bar bucket width in seconds (default 60).
# SSI_STREAM_BAR_SECONDS=60
# Shared-cache TTL for streamed snapshots in ms (default 20000).
# SSI_STREAM_CACHE_TTL_MS=20000
# WebSocket heartbeat interval in ms (default 30000 — server pings every 30s).
# SSI_WS_HEARTBEAT_MS=30000

# ── Verified Financial Data policy (Phase 0) ───────────────────────────────
# Synthetic financial statement generation is DISABLED by default.
# Only set to true for local UI/demo/testing. Never enable in production.
# ALLOW_SYNTHETIC_FINANCIALS=false

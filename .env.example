# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

DATABASE_POOL_MAX=5
DATABASE_POOL_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_STARTUP_RETRIES=10
DATABASE_STARTUP_RETRY_DELAY_MS=2000
DATABASE_SELF_PING_INTERVAL_MS=30000
DATABASE_DOWN_ALERT_AFTER_MS=120000

POSTGRES_USER=orca
POSTGRES_PASSWORD=orca
POSTGRES_DB=orca_financial

# ── Shared cache (REQUIRED on Vercel Production) ──────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_REQUIRED=1

# Set to 1 only on a dedicated worker process. Keep 0 for web/serverless instances.
RUN_BACKGROUND_SCHEDULERS=0

# ── External market-data source adapters (disabled by default) ───────────
# Chỉ bật sau khi đã xác nhận endpoint/API contract và quyền truy cập.
# Adapter không đoán endpoint; URL phải là base URL được cấp phép.
EXTERNAL_DATA_SOURCE_TIMEOUT_MS=8000

# TCBS — source of reported financial statements when explicitly enabled
# Chọn "mcp" khi dùng Remote MCP của TCBS; chọn "rest" cho REST API được cấp quyền.
TCBS_ENABLED=false
TCBS_TRANSPORT=mcp
TCBS_API_URL=
TCBS_API_KEY=
# REST path; chỉ dùng khi TCBS_TRANSPORT=rest.
TCBS_FINANCIALS_PATH=

# TCBS Remote MCP / OAuth transport; không đặt URL MCP vào TCBS_API_URL.
TCBS_MCP_ENABLED=false
TCBS_MCP_URL=https://mcp.tcbs.com.vn/mcp/tcinvest/
# Token server-side chỉ dùng nếu TCBS cấp access token phù hợp.
# Không commit giá trị thật vào repository.
TCBS_MCP_ACCESS_TOKEN=
# Chỉ điền sau khi TCBS cấp OAuth client contract; script refresh không tự tạo initial token.
TCBS_MCP_TOKEN_URL=
TCBS_MCP_CLIENT_ID=
TCBS_MCP_CLIENT_SECRET=
TCBS_MCP_REDIRECT_URI=https://orcafinancial.vercel.app/api/auth/tcbs/callback
TCBS_MCP_REFRESH_TOKEN=
# Local-only output file; không dùng làm Vercel secret store tự động.
TCBS_MCP_TOKEN_OUTPUT_FILE=/tmp/tcbs-oauth-token.json
# bank | nonbank | auto; auto đọc industry mapping, unknown mặc định nonbank
TCBS_MCP_BANK_MODE=auto
# Override khi metadata ngành không đầy đủ, ví dụ VCB,BID,CTG
TCBS_MCP_BANK_SYMBOLS=
# Biến cũ vẫn tương thích; chỉ dùng khi BANK_MODE không được đặt
TCBS_MCP_BANK=false
TCBS_MCP_SYMBOL_ARGUMENT=

# TCBS Investor Relations public-document crawler
TCBS_IR_URL=https://www.tcbs.com.vn/en/investors/
TCBS_CRAWL_SYMBOL=TCX
TCBS_CRAWL_OUTPUT_DIR=data/tcbs-financials
TCBS_CRAWL_MAX_DOCUMENTS=12
TCBS_CRAWL_MAX_BYTES=15000000
TCBS_CRAWL_DELAY_MS=750
# Optional comma-separated official PDF URLs for dynamically rendered pages.
TCBS_CRAWL_DOCUMENT_URLS=
# Excel Data Pack ưu tiên hơn PDF khi đã cấu hình URL chính thức.
TCBS_DATAPACK_URL=https://www.tcbs.com.vn/wp-content/uploads/2026/07/Data-Excel-File_2Q26.xlsx
TCBS_DATAPACK_PERIOD=Q2/2026
TCBS_DATAPACK_OUTPUT=data/tcbs-financials/tcbs-datapack.json
TCBS_MCP_INCOME_TOOL=getIncomeStatementForNonBank
TCBS_MCP_BALANCE_TOOL=getBalanceSheetForNonBank
TCBS_MCP_CASHFLOW_TOOL=getCashFlowForNonBank
TCBS_MCP_BANK_INCOME_TOOL=getIncomeStatementForBank
TCBS_MCP_BANK_BALANCE_TOOL=getBalanceSheetForBank
TCBS_MCP_BANK_CASHFLOW_TOOL=getCashFlowForBank

# Path thường dùng cho contract financial-statements. Có thể chứa {symbol}.
# Nếu không có {symbol}, adapter tự thêm ?symbol={SYMBOL} hoặc &symbol={SYMBOL}.

# CafeF adapter contract
CAFEF_ENABLED=false
CAFEF_API_URL=
CAFEF_API_KEY=

# Vietstock adapter contract
VIETSTOCK_ENABLED=false
VIETSTOCK_API_URL=
VIETSTOCK_API_KEY=

MARKET_DATA_MAX_AGE_MS=129600000
MARKET_OVERVIEW_TTL_MS=60000
MARKET_QUOTE_TTL_MS=20000
MARKET_HIST_D_TTL_MS=120000
MARKET_HIST_INTRA_TTL_MS=30000
MARKET_OVERVIEW_AUX_TIMEOUT_MS=450
MARKET_OVERVIEW_TOTAL_TIMEOUT_MS=2500

CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000
CONNECTOR_RETRY_ATTEMPTS=2
CONNECTOR_RETRY_BASE_MS=700
CONNECTOR_FETCH_TIMEOUT_MS=8000
CONNECTOR_STALE_AFTER_MS=900000
CONNECTOR_DEGRADED_AFTER_MS=300000
CONNECTOR_ALERT_AFTER_MS=300000
CONNECTOR_QUOTE_CONCURRENCY=5
CONNECTOR_SEARCH_CONCURRENCY=3
CONNECTOR_NEWS_INSERT_CONCURRENCY=8

# ── LLM: Groq-only, three specialized lanes ─────────────────────────────
# Không còn OpenRouter. GROQ_KEY là alias tương thích; ưu tiên GROQ_API_KEY.
GROQ_API_KEY=
GROQ_KEY=

# Legacy generic model; chỉ dùng làm compatibility fallback cho Agent.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FINANCE_MODEL=qwen/qwen3.8-27b

# Lane 1 — Analysis: calculations support, financial metrics annotations, chart specs
GROQ_ANALYSIS_MODEL=qwen/qwen3.8-27b
GROQ_ANALYSIS_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile

# Lane 2 — Reporting: Morning Brief and Summary structured reports
GROQ_REPORT_MODEL=openai/gpt-oss-120b
GROQ_REPORT_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile

# Lane 3 — Agent Chat: interactive financial Q&A
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_AGENT_FALLBACK_MODELS=openai/gpt-oss-20b

# Global fallback used only after lane-specific candidates are exhausted.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant
LLM_STRICT=1
AGENT_RESPONSE_TTL_MS=180000

COMMODITY_PRIMARY_SOURCE=simplize
COMMODITY_SCAN_INTERVAL_MS=60000
COMMODITY_RETENTION_DAYS=30
COMMODITY_PRUNE_INTERVAL_MS=21600000

# Optional economic calendar enrichment
FINNHUB_API_KEY=
# ── Quarterly financial-period audit ───────────────────────────────────────
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> automatically.
CRON_SECRET=
# Optional separate secret if the audit endpoint is called by another scheduler.
FINANCIAL_AUDIT_SECRET=
FINANCIAL_AUDIT_SYMBOLS=VNM,HPG,FPT,VCB
FINANCIAL_INGEST_SYMBOLS=VNM,HPG,FPT,VCB
# Licensed TCBS market-data endpoint; leave empty to keep VNDirect as primary.
TCBS_MARKET_DATA_URL=
TCBS_MARKET_DATA_TOKEN=
# Development-only deterministic fixture; production always ignores this flag.
TCBS_MARKET_DATA_MOCK=false
# Licensed/approved JSON endpoint contracts. Do not bypass authentication or rate limits.
VIETSTOCK_DATAFEED_URL=
VIETSTOCK_DATAFEED_TOKEN=
CAFEF_DATA_URL=
CAFEF_DATA_TOKEN=

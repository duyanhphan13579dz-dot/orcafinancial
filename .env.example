# ── Database ──────────────────────────────────────────────────────────────
# Option A — Local / self-hosted PostgreSQL (default for this sandbox):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Option B — Supabase (uncomment and fill in to migrate; see
# docs/SUPABASE_MIGRATION.md for the full step-by-step guide).
#
# Direct connection (use for `npx drizzle-kit push` / migrations / pg_dump):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.
#
# Background self-ping + escalation thresholds.
DATABASE_SELF_PING_INTERVAL_MS=30000
DATABASE_DOWN_ALERT_AFTER_MS=120000

# ── docker-compose.yml only (self-hosted local Postgres deployments) ───────
POSTGRES_USER=orca
POSTGRES_PASSWORD=orca
POSTGRES_DB=orca_financial

# ── Supabase (optional) — enables Auth / Realtime / Storage from the app ───
# Found in Supabase Dashboard → Project Settings → API.
# NEXT_PUBLIC_* vars are exposed to the browser bundle — only put the two
# below there, never the service role key.

# Optional: Slack webhook for connector DOWN alerts.
# SLACK_WEBHOOK_URL=

# ── Multi-provider LLM (free tier first) — used by AI Agent + hybrid sentiment ─
# Cascade order (default): gemini → groq → openrouter → anthropic
# Override: LLM_PROVIDER_ORDER=gemini,groq,openrouter,anthropic
#
# Google Gemini free tier (~1,500 req/day Flash) — recommended primary
# Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
#
# Groq free tier (very fast LPU) — https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# OpenRouter free models — https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional economic calendar enrichment
FINNHUB_API_KEY=
# ── Quarterly financial-period audit ───────────────────────────────────────
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> automatically.
CRON_SECRET=
# Optional separate secret if the audit endpoint is called by another scheduler.
FINANCIAL_AUDIT_SECRET=
FINANCIAL_AUDIT_SYMBOLS=VNM,HPG,FPT,VCB
FINANCIAL_INGEST_SYMBOLS=VNM,HPG,FPT,VCB
# Licensed TCBS market-data endpoint; leave empty to keep VNDirect as primary.
TCBS_MARKET_DATA_URL=
TCBS_MARKET_DATA_TOKEN=
# Development-only deterministic fixture; production always ignores this flag.
TCBS_MARKET_DATA_MOCK=false
# Licensed/approved JSON endpoint contracts. Do not bypass authentication or rate limits.
VIETSTOCK_DATAFEED_URL=
VIETSTOCK_DATAFEED_TOKEN=
CAFEF_DATA_URL=
CAFEF_DATA_TOKEN=

# ── Verified Financial Data policy (Phase 0) ───────────────────────────────
# Synthetic financial statement generation is DISABLED by default.
# Only set to true for local UI/demo/testing. Never enable in production.
# ALLOW_SYNTHETIC_FINANCIALS=false

# ── Fundamental engine (tab Cơ bản) ────────────────────────────────────────
# Dạng trình bày báo cáo tài chính quý.
#   auto          — tự phát hiện luỹ kế (YTD) hay riêng từng quý (mặc định)
#   standalone    — ép coi mọi quý là số riêng lẻ
#   cumulative-ytd— ép coi mọi quý là luỹ kế từ đầu năm
# Phát hiện sai sẽ làm sai LTM, ROE và toàn bộ định giá.
# FINANCIAL_STATEMENT_BASIS=auto

# Giả định định giá. Tỷ lệ ở dạng thập phân (0.045 = 4.5%).
# Rf  — lãi suất phi rủi ro, dùng cho CAPM: Ke = Rf + β × ERP
# VALUATION_RISK_FREE_RATE=0.045
# ERP — phần bù rủi ro cổ phiếu thị trường Việt Nam
# VALUATION_EQUITY_RISK_PREMIUM=0.095
# g   — tốc độ tăng trưởng vĩnh viễn của giai đoạn 2 (Gordon)
# VALUATION_TERMINAL_GROWTH=0.03
# Số năm của giai đoạn tăng trưởng cao trong DCF 2 giai đoạn
# VALUATION_STAGE_ONE_YEARS=5
# Chặn tốc độ tăng trưởng giai đoạn 1 suy ra từ tăng trưởng doanh thu LTM
# VALUATION_MAX_STAGE_ONE_GROWTH=0.25
# VALUATION_MIN_STAGE_ONE_GROWTH=0.02

# ── Realtime market data (websocket) ──────────────────────────────────────
# Chuỗi dự phòng cố định: vndirect → vci → kbs, rồi thăm dò REST.
# vndirect có default; vci/kbs chưa có cổng websocket công khai miễn phí
# được xác minh nên để trống cho tới khi bạn cấu hình endpoint thật.
# VNDIRECT_REALTIME_WS=wss://websocket.vndirect.com.vn/notisocket/noti
# VCI_REALTIME_WS=
# KBS_REALTIME_WS=

# ── CafeF realtime (REST, server-side) ────────────────────────────────────
# Endpoint bắt từ DevTools của CafeF (msh-datacenter). Gọi từ server để tránh
# CORS. Có default sẵn; chỉ cần ghi đè nếu CafeF đổi endpoint.
# CAFEF_REALTIME_URL=https://msh-datacenter.cafef.vn/price/api/v1/CompanyCompact/RealTimeChartHeader
# CAFEF_REALTIME_QUERY=index=1;2
